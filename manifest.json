{
    "manifest_version": 3,
    "name": "Send to Bale",
    "version": "1.0",
    "description": "Send highlighted text and URLs to Bale Messenger",
    "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
    "host_permissions": ["https://tapi.bale.ai/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"]
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Send to Bale"
    },
    "options_page": "options.html"
  }